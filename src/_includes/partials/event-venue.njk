{% if venueItems | length > 0 %}
  {% set imageLeft = (artistItems | length) == 0 %}
  {% for venue in venueItems %}
    <section class="border-b overflow-x-clip">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        {# No artist: image left (like artist block). With artist: image right for alternation. #}
        {# Build class via set so the space before md:order-2 isn't eaten by template whitespace trimming #}
        {% set venueImgClass = "aspect-square overflow-hidden" %}
        {% if not imageLeft %}
          {% set venueImgClass = venueImgClass + " md:order-2" %}
        {% endif %}
        <div class="{{ venueImgClass }}">
          {% if venue.data.images and venue.data.images.featured %}
            {% Picture venue.data.images.featured, "bg-gray-100", "w-full h-full object-cover grayscale", venue.data.images.alt or venue.data.title, "lazy", "(min-width: 768px) 50vw, 100vw" %}

            {% if venue.data.images.credit %}
              {% set imageCreditSource = venue.data.images %}
              {% include "components/image-credit.njk" %}
            {% endif %}
          {% else %}
            <div class="bg-gray-200 w-full h-full flex items-center justify-center text-gray-500">
              No Image Available
            </div>
          {% endif %}
        </div>

        {% set venueTextClass = "text-base py-4 lg:py-12 px-3 lg:px-8 max-w-md" %}
        {% if imageLeft %}
          {% set venueTextClass = venueTextClass + " self-end" %}
        {% else %}
          {% set venueTextClass = venueTextClass + " md:order-1 place-self-end" %}
        {% endif %}
        <div class="{{ venueTextClass }} relative">
          {% if festive %}
            {% set festiveStarsWrap = "-rotate-12 origin-top-left" %}
            {% set festiveStarsClass = "absolute -top-5 -left-3 z-10 pointer-events-none max-sm:scale-90" %}
            {% set festiveStarsIdPrefix = (translationKey or page.url) ~ "-venue-" ~ loop.index %}
            {% include "components/event-festive-stars.njk" %}
            {% set festiveStarsWrap = none %}
            {% set festiveStarsClass = none %}
            {% set festiveStarsIdPrefix = none %}
          {% endif %}
          <span class="text-sm text-orange-500 font-bold tracking-wide uppercase">
            {{ venue.data.city or meta[locale].event.venue }}
          </span>
          <h2 class="standardtitel uppercase">{{ venue.data.title }}</h2>
          <p class="mt-4">{{ venue.data.excerpt }}</p>
          <a href="{{ venue.url }}" class="btn btn-dark mt-6">
            <span class="btn-label">{{ meta[locale].event.readmore }}</span>
            <span class="sr-only"> {{ venue.data.title }}</span>
          </a>
        </div>
      </div>
    </section>
  {% endfor %}
{% endif %}
