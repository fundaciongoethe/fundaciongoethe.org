{% if calendarShows and calendarShows.length %}
  <div class="my-4 text-xs">
    <small>{{ meta[locale].event.addCalendar }}</small>
    {% for show in calendarShows %}
      <div class="{% if calendarShows.length > 1 %}mt-3{% else %}mt-2{% endif %}">
        {% if calendarShows.length > 1 %}
          <p class="text-gray-400 mb-1">
            {{ meta[locale].event.show }} {{ show.start | date("HH:mm", locale) }}
          </p>
        {% endif %}
        <ul class="add-to-calendar flex flex-wrap gap-x-3 gap-y-1">
          <li>
            <a
              class="text-white hover:text-yellow-400 underline-offset-2 hover:underline"
              href="{{ show.googleLink }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ meta[locale].event.calendarGoogle }}
            </a>
          </li>
          <li>
            <a
              class="text-white hover:text-yellow-400 underline-offset-2 hover:underline"
              href="{{ show.outlookLink }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ meta[locale].event.calendarOutlook }}
            </a>
          </li>
          <li>
            <a
              class="text-white hover:text-yellow-400 underline-offset-2 hover:underline"
              href="{{ show.officeLink }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ meta[locale].event.calendarOffice }}
            </a>
          </li>
          <li>
            <a
              class="text-white hover:text-yellow-400 underline-offset-2 hover:underline"
              href="{{ show.icsLink }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ meta[locale].event.calendarIcs }}
            </a>
          </li>
        </ul>
      </div>
    {% endfor %}
  </div>
{% endif %}
