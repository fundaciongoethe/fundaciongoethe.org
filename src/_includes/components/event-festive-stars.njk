{# set festiveStarsClass for placement; festiveStarsCompact for archive size; festiveStarsIdPrefix when many on a page; festiveStarsWrap to override random wrap rotate #}
{% set _starId = festiveStarsIdPrefix or 'festive' %}
{% set stars = helpers.festiveStarsClasses(_starId, festiveStarsCompact) %}
<div class="flex items-end gap-1 {{ festiveStarsWrap or stars.wrap }} {{ festiveStarsClass or '' }}" aria-hidden="true">
  {% svg "star", stars.a, "hidden", "star", _starId ~ "-a" %}
  {% svg "star", stars.b, "hidden", "star", _starId ~ "-b" %}
  {% svg "star", stars.c, "hidden", "star", _starId ~ "-c" %}
</div>
